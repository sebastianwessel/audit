{
  "name": "@sebastianwessel/audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A human-gated, read-only agentic security audit workflow for source repositories.",
  "license": "UNLICENSED",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run schema:check && bun test && bun run eval:acquisition-snapshots && bun run eval:corpus:integration",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov && bun run scripts/check-coverage.ts",
    "eval": "bun run src/features/evaluation/run.ts",
    "eval:stages": "bun run --bun src/features/evaluation/run-stage-conformance.ts",
    "eval:corpus:integration": "bun run --bun src/features/evaluation/run-deterministic-corpus-integration.ts",
    "eval:corpus:readiness": "bun run src/features/evaluation/run-corpus-readiness.ts",
    "eval:candidates": "bun run src/features/evaluation/run-candidate-check.ts",
    "eval:acquisition": "bun run src/features/evaluation/run-acquisition-track.ts",
    "eval:acquire": "bun run --bun src/features/evaluation/run-source-pair-acquisition.ts",
    "eval:acquisition-snapshots": "bun run src/features/evaluation/run-acquired-source-pairs.ts",
    "eval:import": "bun run src/features/evaluation/run-import.ts",
    "eval:provider": "bun run --bun src/features/evaluation/run-provider.ts",
    "eval:provider:preflight": "bun run --bun src/features/evaluation/run-provider-preflight.ts",
    "eval:plan-semantic": "bun run --bun src/features/evaluation/run-plan-semantic-adjudication.ts",
    "eval:plan-semantic:summary": "bun run --bun src/features/evaluation/run-plan-semantic-summary.ts",
    "eval:smoke": "bun run --bun src/features/evaluation/run-provider-smoke.ts",
    "eval:compare": "bun run --bun src/features/evaluation/run-compare.ts",
    "update:model-pricing": "bun run scripts/update-model-pricing.ts",
    "update:model-pricing:write": "bun run scripts/update-model-pricing.ts --write",
    "start": "bun run --bun src/cli/main.ts",
    "spec:check": "bun run scripts/check-specs.ts",
    "schema:generate": "bun run scripts/generate-schemas.ts",
    "schema:check": "bun run scripts/check-schema-artifacts.ts"
  },
  "dependencies": {
    "@purista/harness": "^1.7.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@purista/harness-anthropic": "^1.7.1",
    "@purista/harness-openai": "^1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "@purista/harness@1.7.1": "patches/@purista%2Fharness@1.7.1.patch"
  }
}
