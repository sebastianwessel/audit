{
  "name": "@sebastianwessel/audit",
  "version": "0.1.0",
  "type": "module",
  "description": "A human-gated, read-only agentic security audit workflow for source repositories.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianwessel/audit.git"
  },
  "bugs": {
    "url": "https://github.com/sebastianwessel/audit/issues"
  },
  "homepage": "https://github.com/sebastianwessel/audit#readme",
  "keywords": [
    "security",
    "security-audit",
    "static-analysis",
    "sast",
    "agentic",
    "code-review",
    "bun",
    "typescript"
  ],
  "bin": {
    "audit": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "check": "bun run ci:scripts && bun run typecheck && bun run lint && bun test && bun run eval:acquisition-snapshots && bun run eval:corpus:integration && bun run package:check",
    "build": "bun build ./src/cli/main.ts --outdir ./dist --target bun --format esm --external '@modelcontextprotocol/sdk/*'",
    "package:check": "bun run build && bun ./dist/main.js --help",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov && bun run scripts/check-coverage.ts",
    "eval:stages": "bun run --bun evaluation/src/run-stage-conformance.ts",
    "eval:stage-semantic": "bun run --bun evaluation/src/run-stage-semantic.ts",
    "eval:stage-isolated:prepare": "bun run --bun evaluation/src/run-prepare-stage-isolated-packs.ts",
    "eval:corpus:integration": "bun run --bun evaluation/src/run-deterministic-corpus-integration.ts",
    "eval:corpus:readiness": "bun run evaluation/src/run-corpus-readiness.ts",
    "eval:candidates": "bun run evaluation/src/run-candidate-check.ts",
    "eval:acquisition": "bun run evaluation/src/run-acquisition-track.ts",
    "eval:acquire": "bun run --bun evaluation/src/run-source-pair-acquisition.ts",
    "eval:acquisition-snapshots": "bun run evaluation/src/run-acquired-source-pairs.ts",
    "eval:import": "bun run evaluation/src/run-import.ts",
    "eval:provider": "bun run --bun evaluation/src/run-provider.ts",
    "eval:provider:preflight": "bun run --bun evaluation/src/run-provider-preflight.ts",
    "eval:provider:lock:inspect": "bun run --bun evaluation/src/run-provider.ts inspect-lock",
    "eval:provider:lock:release": "bun run --bun evaluation/src/run-provider.ts release-lock",
    "eval:smoke": "bun run --bun evaluation/src/run-provider-smoke.ts",
    "eval:compare": "bun run --bun evaluation/src/run-compare.ts",
    "update:model-pricing": "bun run scripts/update-model-pricing.ts",
    "update:model-pricing:write": "bun run scripts/update-model-pricing.ts --write",
    "start": "bun run --bun src/cli/main.ts",
    "ci:scripts": "bun run scripts/check-ci-scripts.ts",
    "spec:check": "bun run scripts/check-specs.ts",
    "schema:check": "bun run spec:check"
  },
  "dependencies": {
    "@purista/harness": "^1.7.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@purista/harness-anthropic": "^1.7.2",
    "@purista/harness-openai": "^1.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
