{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "apiKeyEnvironmentVariable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "artifactDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "evaluationCorpusRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "evaluationOutputRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "maxParallelVectors": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maxEstimatedCostUsd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "modelPricing": {
      "type": "object",
      "properties": {
        "inputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "cachedInputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "outputPerMillion": {
          "type": "number",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "const": "catalogue"
        }
      },
      "additionalProperties": false
    },
    "verificationMode": {
      "type": "string",
      "enum": [
        "same-route",
        "independent-route"
      ]
    },
    "independentVerifierRoute": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "apiKeyEnvironmentVariable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "modelPricing": {
          "type": "object",
          "properties": {
            "inputPerMillion": {
              "type": "number",
              "minimum": 0
            },
            "cachedInputPerMillion": {
              "type": "number",
              "minimum": 0
            },
            "outputPerMillion": {
              "type": "number",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "const": "catalogue"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "model",
        "apiKeyEnvironmentVariable",
        "modelPricing"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "artifactDirectory",
    "evaluationCorpusRoot",
    "evaluationOutputRoot",
    "maxParallelVectors",
    "modelPricing",
    "verificationMode"
  ],
  "additionalProperties": false
}
