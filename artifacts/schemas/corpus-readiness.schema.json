{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "packVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "counts": {
      "type": "object",
      "properties": {
        "caseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "realWorldCaseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pairedCaseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "realWorldPairedProjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "realWorldDualReviewedPairedProjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dualReviewedPatchedNegativeProjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "developmentRealWorldPairedProjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "developmentDualReviewedRealWorldPairedProjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "privateHoldoutRealWorldPairedProjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dualReviewedPrivateHoldoutRealWorldPairedProjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "realWorldLanguageFamilyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dualReviewedRealWorldLanguageFamilyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coveredRequiredControlFamilyCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "caseCount",
        "realWorldCaseCount",
        "pairedCaseCount",
        "realWorldPairedProjectCount",
        "realWorldDualReviewedPairedProjectCount",
        "dualReviewedPatchedNegativeProjectCount",
        "developmentRealWorldPairedProjectCount",
        "developmentDualReviewedRealWorldPairedProjectCount",
        "privateHoldoutRealWorldPairedProjectCount",
        "dualReviewedPrivateHoldoutRealWorldPairedProjectCount",
        "realWorldLanguageFamilyCount",
        "dualReviewedRealWorldLanguageFamilyCount",
        "coveredRequiredControlFamilyCount"
      ],
      "additionalProperties": false
    },
    "byEvidenceOrigin": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "caseCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "projectCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "caseCount",
          "projectCount"
        ],
        "additionalProperties": false
      }
    },
    "byLanguage": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "caseCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "projectCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "caseCount",
          "projectCount"
        ],
        "additionalProperties": false
      }
    },
    "byDataset": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "caseCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "projectCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "key",
          "caseCount",
          "projectCount"
        ],
        "additionalProperties": false
      }
    },
    "byControlFamily": {
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "dynamic-state-ownership",
              "authorization-tenancy",
              "validation-canonicalization",
              "sensitive-data-handling",
              "unsafe-operation-bounds",
              "injection-outbound-boundary"
            ]
          },
          "realWorldPairedProjectCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dualReviewedRealWorldPairedProjectCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "family",
          "realWorldPairedProjectCount",
          "dualReviewedRealWorldPairedProjectCount"
        ],
        "additionalProperties": false
      }
    },
    "criteria": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "level": {
            "type": "string",
            "enum": [
              "pilot",
              "reliability-gate"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "repository-disjoint-pairs",
              "control-families",
              "language-families"
            ]
          },
          "observedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minimumCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "met": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "criterionId",
          "level",
          "unit",
          "observedCount",
          "minimumCount",
          "met",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "pilotReady": {
      "type": "boolean"
    },
    "reliabilityGateReady": {
      "type": "boolean"
    },
    "limitations": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "generatedAt",
    "counts",
    "byEvidenceOrigin",
    "byLanguage",
    "byDataset",
    "byControlFamily",
    "criteria",
    "pilotReady",
    "reliabilityGateReady",
    "limitations"
  ],
  "additionalProperties": false
}
