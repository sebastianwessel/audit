{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "includeGlobs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "defaultExclusions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "vcs-metadata",
          "dependency-or-vendor-cache",
          "build-or-generated-output",
          "local-secret-store",
          "outside-includes",
          "invalid-encoding"
        ]
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "vcs-metadata",
          "dependency-or-vendor-cache",
          "build-or-generated-output",
          "local-secret-store",
          "outside-includes",
          "invalid-encoding"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "includeGlobs",
    "defaultExclusions",
    "overrides"
  ],
  "additionalProperties": false
}
