{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "lineageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "previous": {
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "planId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "targetFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "reportId",
        "planId",
        "targetFingerprint"
      ],
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "planId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "targetFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "reportId",
        "planId",
        "targetFingerprint"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "new": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "persisting": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "new",
        "persisting",
        "resolved",
        "unknown"
      ],
      "additionalProperties": false
    },
    "entries": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingIdentity": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "previousFindingId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentFindingId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "previousVectorId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentVectorId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "persisting",
              "resolved",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "exact-match-and-coverage-complete",
              "exact-match-but-coverage-incomplete-or-missing",
              "no-exact-match-and-coverage-complete",
              "no-exact-match-and-coverage-incomplete-or-missing"
            ]
          }
        },
        "required": [
          "findingIdentity",
          "previousFindingId",
          "currentFindingId",
          "previousVectorId",
          "currentVectorId",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "lineageId",
    "generatedAt",
    "previous",
    "current",
    "counts",
    "entries"
  ],
  "additionalProperties": false
}
