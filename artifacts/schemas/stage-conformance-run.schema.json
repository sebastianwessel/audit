{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "mode": {
      "type": "string",
      "const": "deterministic-stage-conformance"
    },
    "provider": {
      "type": "string",
      "const": "in-process-scripted-fixture"
    },
    "stages": {
      "minItems": 7,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "planning",
              "evidence-mapping",
              "source-posture",
              "investigation",
              "candidate-grounding",
              "verification",
              "countercheck"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "inspected",
              "retry-safe"
            ]
          },
          "scopePreserved": {
            "type": "boolean",
            "const": true
          },
          "toolUsage": {
            "type": "object",
            "properties": {
              "toolCallCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "listFilesCallCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "readFileCallCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "grepFilesCallCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "successfulReadFileCallCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "successfulGrepFilesCallCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rejectedCallCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "returnedBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "budgetExhausted": {
                "type": "boolean"
              }
            },
            "required": [
              "toolCallCount",
              "listFilesCallCount",
              "readFileCallCount",
              "grepFilesCallCount",
              "successfulReadFileCallCount",
              "successfulGrepFilesCallCount",
              "rejectedCallCount",
              "returnedBytes",
              "budgetExhausted"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "stage",
          "outcome",
          "scopePreserved",
          "toolUsage"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "provider",
    "stages"
  ],
  "additionalProperties": false
}
