{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "targetFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "object",
      "properties": {
        "fileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "languageHints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      },
      "required": [
        "fileCount",
        "totalBytes",
        "languageHints"
      ],
      "additionalProperties": false
    },
    "sourcePaths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "policy": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "includeGlobs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "defaultExclusions": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "vcs-metadata",
                  "dependency-or-vendor-cache",
                  "build-or-generated-output",
                  "local-secret-store",
                  "outside-includes",
                  "invalid-encoding"
                ]
              }
            },
            "overrides": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "vcs-metadata",
                  "dependency-or-vendor-cache",
                  "build-or-generated-output",
                  "local-secret-store",
                  "outside-includes",
                  "invalid-encoding"
                ]
              }
            }
          },
          "required": [
            "schemaVersion",
            "includeGlobs",
            "defaultExclusions",
            "overrides"
          ],
          "additionalProperties": false
        },
        "targetFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rows": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "disposition": {
                    "type": "string",
                    "const": "admitted"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "objectRef": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "languageHint": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "disposition",
                  "path",
                  "byteLength",
                  "contentDigest",
                  "objectRef",
                  "languageHint"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "disposition": {
                    "type": "string",
                    "const": "excluded"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "vcs-metadata",
                      "dependency-or-vendor-cache",
                      "build-or-generated-output",
                      "local-secret-store",
                      "outside-includes",
                      "invalid-encoding"
                    ]
                  }
                },
                "required": [
                  "disposition",
                  "path",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "policy",
        "targetFingerprint",
        "rows"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "architecture",
              "deployment",
              "data-flow",
              "controls",
              "threat-model",
              "other"
            ]
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "appliesTo": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "title",
          "kind",
          "sensitivity",
          "appliesTo",
          "body",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "targetFingerprint",
    "contextDigest",
    "summary",
    "sourcePaths",
    "sourceSnapshot",
    "context"
  ],
  "additionalProperties": false
}
