{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "registryId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "datasetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "datasetId",
        "title",
        "sourceUrl",
        "revision",
        "license",
        "retrievedAt",
        "attribution"
      ],
      "additionalProperties": false
    },
    "candidates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "sourceRecordId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "repositoryUrl": {
            "type": "string",
            "format": "uri"
          },
          "vulnerableRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "patchedRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "metadataPath": {
            "type": "string",
            "minLength": 1
          },
          "metadataDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceLicenseStatus": {
            "type": "string",
            "enum": [
              "unverified",
              "verified",
              "rejected"
            ]
          }
        },
        "required": [
          "candidateId",
          "sourceRecordId",
          "repositoryUrl",
          "vulnerableRevision",
          "patchedRevision",
          "metadataPath",
          "metadataDigest",
          "sourceLicenseStatus"
        ],
        "additionalProperties": false
      }
    },
    "registryDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "registryId",
    "source",
    "candidates",
    "registryDigest"
  ],
  "additionalProperties": false
}
