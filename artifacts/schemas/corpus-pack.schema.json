{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "packVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "datasets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "datasetId",
          "title",
          "sourceUrl",
          "revision",
          "license",
          "retrievedAt",
          "attribution"
        ],
        "additionalProperties": false
      }
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "datasetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "projectId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "repositoryUrl": {
            "type": "string",
            "format": "uri"
          },
          "vulnerableRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "patchedRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9+._-]*$"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "split": {
            "type": "string",
            "enum": [
              "development",
              "test",
              "private-holdout"
            ]
          },
          "evidenceOrigin": {
            "type": "string",
            "enum": [
              "real-world",
              "synthetic",
              "semantic-regression"
            ]
          },
          "controlFamilies": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dynamic-state-ownership",
                "authorization-tenancy",
                "validation-canonicalization",
                "sensitive-data-handling",
                "unsafe-operation-bounds",
                "injection-outbound-boundary"
              ]
            }
          },
          "variantMode": {
            "type": "string",
            "enum": [
              "paired",
              "single"
            ]
          },
          "sourceDirectories": {
            "type": "object",
            "properties": {
              "vulnerable": {
                "type": "string",
                "minLength": 1
              },
              "patched": {
                "type": "string",
                "minLength": 1
              },
              "benign": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "vulnerable"
            ],
            "additionalProperties": false
          },
          "sourceDigests": {
            "type": "object",
            "properties": {
              "vulnerable": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "patched": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "benign": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "vulnerable"
            ],
            "additionalProperties": false
          },
          "contextDirectory": {
            "type": "string",
            "minLength": 1
          },
          "answerKeyPath": {
            "type": "string",
            "minLength": 1
          },
          "reviewedPlanPath": {
            "type": "string",
            "minLength": 1
          },
          "transformedContentDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "caseId",
          "datasetId",
          "projectId",
          "repositoryUrl",
          "vulnerableRevision",
          "language",
          "difficulty",
          "split",
          "evidenceOrigin",
          "controlFamilies",
          "variantMode",
          "sourceDirectories",
          "sourceDigests",
          "answerKeyPath",
          "reviewedPlanPath",
          "transformedContentDigest"
        ],
        "additionalProperties": false
      }
    },
    "redistributionDecision": {
      "type": "string",
      "enum": [
        "metadata-only",
        "private-research-source-only",
        "source-included-with-license"
      ]
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "createdAt",
    "datasets",
    "cases",
    "redistributionDecision",
    "manifestDigest"
  ],
  "additionalProperties": false
}
