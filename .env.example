# Audit local configuration
#
# Copy this file to `.env` (which is gitignored) and fill in only what you need:
#   cp .env.example .env
#
# Precedence: built-in defaults < inherited process environment < .env.
# CLI inputs select one operation but cannot override runtime configuration.
# Secrets are never written to artifacts, reports, telemetry, or logs.

# --- Provider (required only for a model-backed plan, audit, or provider evaluation)
# provider: openai | anthropic
AUDIT_PROVIDER=openai
AUDIT_MODEL=
# Optional: override the default key name for the selected provider.
# AUDIT_API_KEY_ENV=OPENAI_API_KEY

# --- Provider credentials -------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local artifact and evaluation paths ---------------------------------
# Private work is local-only: plans, snapshots, checkpoints, and resumable state.
AUDIT_PRIVATE_WORK_DIR=.audit-work
# Public artifacts are safe to upload: source-minimal reports, lineage, manifests.
AUDIT_PUBLIC_ARTIFACT_DIR=.audit-artifacts
AUDIT_EVALUATION_CORPUS_ROOT=evaluation/data/corpora
AUDIT_EVALUATION_OUTPUT_ROOT=evaluation/runs
AUDIT_MAX_PARALLEL_VECTORS=1

# --- Cost accounting ------------------------------------------------------
# Prices come from the bundled, versioned catalogue. Do not configure prices
# here. Contributors refresh the reviewed snapshot with:
# `bun run update:model-pricing:write`.
# Optional observed-cost dispatch guard. Leave unset to disable it.
# AUDIT_MAX_ESTIMATED_COST_USD=

# --- Experimental independent verifier (provider evaluation only) ----------
# Default is same-route. `independent-route` is rejected by product plan/audit
# commands until a qualified corpus comparison promotes it.
# AUDIT_VERIFICATION_MODE=same-route
# AUDIT_VERIFIER_PROVIDER=anthropic
# AUDIT_VERIFIER_MODEL=
# AUDIT_VERIFIER_API_KEY_ENV=ANTHROPIC_API_KEY
