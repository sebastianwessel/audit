# Security Reviewer local configuration
#
# Copy this file to `.env` (which is gitignored) and fill in only what you need:
#   cp .env.example .env
#
# Precedence: built-in defaults < inherited process environment < .env < CLI flags.
# Secrets are never written to artifacts, reports, telemetry, or logs.

# --- Provider (required only for a model-backed plan, audit, or provider evaluation)
# provider: openai | anthropic
SECURITY_REVIEWER_PROVIDER=openai
SECURITY_REVIEWER_MODEL=
# Optional: override the default key name for the selected provider.
# SECURITY_REVIEWER_API_KEY_ENV=OPENAI_API_KEY

# --- Provider credentials -------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local artifact and evaluation paths ---------------------------------
# CLI commands create this directory when needed.
SECURITY_REVIEWER_ARTIFACT_DIR=.security-review-artifacts
SECURITY_REVIEWER_EVALUATION_CORPUS_ROOT=evaluation/corpora
SECURITY_REVIEWER_EVALUATION_OUTPUT_ROOT=evaluation/runs
SECURITY_REVIEWER_MAX_PARALLEL_VECTORS=1

# --- Cost accounting ------------------------------------------------------
# Prices come from the bundled, versioned catalogue. Do not configure prices
# here. Contributors refresh the reviewed snapshot with:
# `bun run update:model-pricing:write`.

# --- Experimental independent verifier (provider evaluation only) ----------
# Default is same-route. `independent-route` is rejected by product plan/audit
# commands until a qualified corpus comparison promotes it.
# SECURITY_REVIEWER_VERIFICATION_MODE=same-route
# SECURITY_REVIEWER_VERIFIER_PROVIDER=anthropic
# SECURITY_REVIEWER_VERIFIER_MODEL=
# SECURITY_REVIEWER_VERIFIER_API_KEY_ENV=ANTHROPIC_API_KEY
